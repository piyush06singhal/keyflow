NEXT_PUBLIC_APP_URL=http://localhost:3000

# One or more Groq API keys, comma- or newline-separated. Requests round-robin
# across all keys, and a rate-limited key is temporarily skipped in favor of
# the others. This is the only AI provider used by default.
GROQ_API_KEYS=gsk_xxxxxxxx,gsk_yyyyyyyy

# Optional alternate AI provider. Not used unless explicitly requested via
# selectAiProvider(kind, "gemini") in code — safe to leave unset.
GOOGLE_GEMINI_API_KEY=
